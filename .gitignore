# Portable single-file build output (large, regenerate with installer\build-portable.ps1)
run/

# Build artifacts
**/bin/
**/obj/

# Clarion build output + generated preview pages in the examples
examples/**/*.exe
examples/**/*.lib
examples/**/*.dll
examples/**/*.sln
examples/**/*.sln.cache
examples/**/*.obj
examples/**/map/
examples/**/my3D_preview.html

# Third-party AJE template assets (not redistributed)
templates/AJEBackupAPP.tpl
templates/AJE*.png
templates/aje*.png
templates/ajebackup.zip

# Edge user-data-dir leftovers from my3D embedded-browser testing
examples/**/*.edge/
*.edge/

# transient render-test result files
examples/**/_*.ini
*_result.ini

# myYuru temp render output
examples/**/yuru*.bmp
examples/**/shot_*.bmp
examples/**/shot_*.png
examples/**/native_*.bmp
examples/**/bench.ini

# myExport demo output
examples/**/Invoices*
examples/**/dlg.ini
examples/**/col.ini

# DrawPlus is a local-only port - never push it
docs/DrawPlus-*
templates/DrawPlus/
examples/DrawPlus/
