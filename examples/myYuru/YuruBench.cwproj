  <PropertyGroup>
    <ProjectGuid>{B7D4E1A2-3C56-4F80-9A21-6E5F1C74B380}</ProjectGuid>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">Win32</Platform>
